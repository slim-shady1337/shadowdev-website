{
  "name": "ShadowDev",
  "version": 1,
  "world": "foundry — heat where work happens, vellum where it is delivered",
  "colors": {
    "tmina": { "value": "#0b0d0e", "role": "ground" },
    "grafit": { "value": "#15191b", "role": "raised surface" },
    "grafit-2": { "value": "#1c2123", "role": "plate on plate" },
    "celik": { "value": "#8c9298", "role": "secondary on iron" },
    "hartija": { "value": "#ecede8", "role": "cooled vellum" },
    "jezgro": { "value": "#ff5e1f", "role": "primary / live work" },
    "zar": { "value": "#ff9911", "role": "secondary / hottest edge" },
    "tekst-d": { "value": "#d9dcd6", "role": "reading text on iron" },
    "tinta": { "value": "#0b0d0e", "role": "ink on vellum" },
    "celik-tinta": { "value": "#525a5e", "role": "secondary on vellum" },
    "greska": { "value": "#a3210d", "role": "form error, vellum only" }
