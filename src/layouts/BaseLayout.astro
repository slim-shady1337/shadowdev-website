---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/sections.css';
import '../styles/journey.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { meta, nav, hero, convergence } from '../content/site';

const siteUrl = 'https://shadowdev.ba/';
const title = meta.title.bs;
const description = meta.description.bs;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ShadowDev',
  slogan: 'OneForAll',
  url: siteUrl,
  logo: `${siteUrl}brand/lockup-color.png`,
  image: `${siteUrl}og.png`,
  email: 'kontakt@shadowdev.ba',
  telephone: '+38761000000',
  description,
  areaServed: { '@type': 'Country', name: 'Bosnia and Herzegovina' },
  knowsAbout: [
    'ERP sistemi',
    'MES — praćenje proizvodnje',
    'Softver po mjeri',
    'Integracije i API',
    'Web stranice i web aplikacije',
    'Mobilne aplikacije',
    'Digitalni marketing'
  ]
};
---

<!doctype html>
<html
  lang="bs"
  data-title-bs={meta.title.bs}
  data-title-en={meta.title.en}
  data-desc-bs={meta.description.bs}
  data-desc-en={meta.description.en}
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />
    <meta name="theme-color" content="#0b0d0e" />
    <meta name="robots" content="index, follow" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />

    <link rel="preload" as="font" type="font/woff2" href="/fonts/anybody-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/anybody-latin-ext.woff2" crossorigin />

    <noscript>
      <style>
        .hero__still {
          display: block;
        }
      </style>
    </noscript>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ShadowDev" />
    <meta property="og:locale" content="bs_BA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={`${siteUrl}og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ShadowDev — OneForAll" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}og.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          if (localStorage.getItem('sd-lang') === 'en') d.lang = 'en';
        } catch (e) {}
        var reduce = false;
        try {
          reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        } catch (e) {}
        if (reduce) {
          d.classList.add('reduced', 'no-3d');
          return;
        }
        try {
          var c = document.createElement('canvas');
          var gl = c.getContext('webgl2') || c.getContext('webgl');
          if (!gl) {
            d.classList.add('no-3d');
          } else {
            var lose = gl.getExtension('WEBGL_lose_context');
            if (lose) lose.loseContext();
          }
        } catch (e) {
          d.classList.add('no-3d');
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main" data-bs={nav.skip.bs} data-en={nav.skip.en}>{nav.skip.bs}</a>

    <div class="field" aria-hidden="true"></div>
    <div class="world" aria-hidden="true">
      <canvas id="world-canvas"></canvas>
    </div>

    <Nav />

    <main id="main">
      <div id="journey">
        <slot name="journey" />
      </div>

      <div class="after" data-bg="paper">
        <slot />
      </div>
    </main>

    <Footer />

    <div class="dimrule" aria-hidden="true">
      <span class="dimrule__label">
        <span data-bs="Sklop" data-en="Assembly">Sklop</span>
        <b id="dimrule-value">00</b>
        <span>/ 06</span>
      </span>
      <span class="dimrule__track">
        <i class="dimrule__line"></i>
        <i class="dimrule__fill"></i>
        <i class="dimrule__head"></i>
      </span>
      <span class="dimrule__label" id="dimrule-name">Početak</span>
    </div>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
