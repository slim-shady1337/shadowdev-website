---
// Statistika — animirani brojači + prednosti
const stats = [
  { value: 20, suffix: '+', label: 'Realizovanih projekata' },
  { value: 5, suffix: '+', label: 'Godina iskustva' },
  { value: 12, suffix: '+', label: 'Zadovoljnih klijenata' },
  { value: 99, suffix: '.9%', label: 'Uptime naših sistema' },
];
---

<section class="section" id="zasto" style="padding-top: 0;">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <span class="eyebrow">Zašto ShadowDev</span>
        <h2 class="section-title">Brojke koje <span class="accent">govore</span></h2>
      </div>
      <p class="section-subtitle">Mjerljivi rezultati i dugoročna partnerstva — zato nam klijenti vjeruju.</p>
    </div>

    <div class="stats-grid">
      {stats.map((stat, i) => (
        <div class="stat" data-reveal style={`--reveal-i: ${i}`}>
          <div class="value"><span data-count={stat.value}>0</span><span class="suffix">{stat.suffix}</span></div>
          <div class="label">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
