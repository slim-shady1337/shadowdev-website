---
import { nav, stations } from '../content/site';
import { bi } from '../lib/bi';
---

{stations.map((s) => (
  <section
    class="station"
    id={`stanica-${s.n}`}
    data-station={s.n}
    aria-labelledby={`station-title-${s.n}`}
  >
    <div class="shell station__grid">
      <div class="station__body">
        <div class="station__index">
          <span class="station__num">{String(s.n).padStart(2, '0')}</span>
          <span class="station__kind" {...bi(s.kind)}>{s.kind.bs}</span>
        </div>

        <div class="station__copy">
          <h2 id={`station-title-${s.n}`} class="u-display station__title" {...bi(s.title)}>
            {s.title.bs}
          </h2>
          <p class="station__lead" {...bi(s.lead)}>{s.lead.bs}</p>
          <p class="station__text" {...bi(s.body)}>{s.body.bs}</p>
          <p class="station__terms" {...bi(s.terms)}>{s.terms.bs}</p>
          <a class="btn btn--ghost station__action" href={s.href}>
            <span class="btn__face" {...bi(nav.cta)}>{nav.cta.bs}</span>
          </a>
        </div>
      </div>

      {/* After the copy in the DOM so the heading is read first; on phones it
          is pulled above with `order`. */}
      {s.n === 2 && <div class="station__figure" id="station-figure-2"></div>}
    </div>
  </section>
))}
