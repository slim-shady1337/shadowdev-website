---
// Tehnologije — stack u obliku chipova
const tech = ['React', 'Astro', 'TypeScript', 'C# / .NET', 'Node.js', 'PostgreSQL', 'REST API', 'GraphQL', 'Docker', 'AWS', 'Azure', 'GitHub Actions'];
---

<section class="section" id="tehnologije" style="padding-top: 0;">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <span class="eyebrow">Tehnologije</span>
        <h2 class="section-title">Alati koje <span class="accent">koristimo</span></h2>
      </div>
      <p class="section-subtitle">Moderan, provjeren stack — odabran za performanse, sigurnost i lako održavanje.</p>
    </div>

    <div class="tech-grid" data-reveal style="--reveal-i: 1">
      {tech.map((t) => (
        <span class="tech-chip"><span class="chip-dot"></span>{t}</span>
      ))}
    </div>
  </div>
</section>
