---
import { security } from '../content/site';
import { bi } from '../lib/bi';
---

<section class="band" id="sigurnost" aria-labelledby="security-title">
  <div class="shell band__inner">
    <div class="head">
      <h2 id="security-title" class="u-display" {...bi(security.h2)}>{security.h2.bs}</h2>
      <p class="u-lead" {...bi(security.lead)}>{security.lead.bs}</p>
    </div>

    <ul class="mech">
      {security.items.map((item) => (
        <li class="mech__item">
          <h3 class="mech__key" {...bi(item.k)}>{item.k.bs}</h3>
          <p class="mech__value" {...bi(item.v)}>{item.v.bs}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
