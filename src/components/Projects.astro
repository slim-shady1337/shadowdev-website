---
// Portfolio — mreža projektnih kartica (primjeri, zamijeniti stvarnim projektima)
const projects = [
  { label: 'ERP', title: 'Proizvodni ERP za metalnu industriju', desc: 'Kompletna integracija nabavke, proizvodnje i prodaje sa analitikom u realnom vremenu.' },
  { label: 'MES', title: 'MES integracija sa CNC mašinama', desc: 'Automatsko prikupljanje podataka sa mašina i praćenje OEE-a proizvodne linije.' },
  { label: 'Web', title: 'E-commerce platforma', desc: 'Moderna web prodavnica sa CMS-om, plaćanjem i integracijom logistike.' },
  { label: 'App', title: 'Mobilna aplikacija za logistiku', desc: 'iOS i Android aplikacija za praćenje isporuka i skladišta u stvarnom vremenu.' },
];
---

<section class="section" id="portfolio">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <span class="eyebrow">Portfolio</span>
        <h2 class="section-title">Odabrani <span class="accent">projekti</span></h2>
      </div>
      <p class="section-subtitle">Pogledajte kako smo klijentima pretvorili izazove u digitalna rješenja.</p>
    </div>

    <div class="projects-grid">
      {projects.map((project, i) => (
        <article class="project-card" data-reveal style={`--reveal-i: ${i % 2}`}>
          <div class="project-thumb">
            <div class="thumb-pattern" aria-hidden="true"></div>
            <span class="thumb-label">{project.label}</span>
          </div>
          <div class="project-body">
            <h3>{project.title}</h3>
            <p>{project.desc}</p>
            <a href="#kontakt" class="project-link">Saznajte više <span class="arrow">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
