---
// Kontakt — veliki CTA + Netlify forma + kontakt podaci
---

<section class="section" id="kontakt">
  <div class="container">
    <div class="contact-field" data-reveal>
      <div class="contact-inner">
        <div>
          <span class="eyebrow">Kontakt</span>
          <h2 class="contact-title">Spremni za digitalnu <span class="accent">budućnost?</span></h2>
          <p class="contact-text">
            Zakažite besplatni sastanak i otkrijte kako možemo unaprijediti vaše poslovanje.
            Odgovaramo u roku od 24 sata.
          </p>
          <div class="contact-meta">
            <a href="mailto:info@shadowdev.ba">✉ info@shadowdev.ba</a>
            <a href="tel:+38761000000">✆ +387 61 000 000</a>
            <span>📍 Bosna i Hercegovina</span>
          </div>
        </div>

        <form name="kontakt" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="form">
          <p style="display:none">
            <label>Ne popunjavaj: <input name="bot-field" /></label>
          </p>

          <div class="form-row">
            <div class="field">
              <label for="kontakt-ime">Ime i prezime *</label>
              <input type="text" id="kontakt-ime" name="ime" required placeholder="Vaše ime" autocomplete="name" />
            </div>
            <div class="field">
              <label for="kontakt-email">Email *</label>
              <input type="email" id="kontakt-email" name="email" required placeholder="vas@email.com" autocomplete="email" />
            </div>
          </div>

          <div class="field">
            <label for="kontakt-poruka">Poruka *</label>
            <textarea id="kontakt-poruka" name="poruka" required placeholder="Opišite vaš projekt ili upit..."></textarea>
          </div>

          <button type="submit" class="btn btn--lg" data-magnetic>Pošalji upit <span class="btn-arrow">→</span></button>
        </form>
      </div>
    </div>
  </div>
</section>
