---
import { process } from '../content/site';
import { bi } from '../lib/bi';
---

<section class="band" id="proces" aria-labelledby="process-title">
  <div class="shell band__inner">
    <div class="head">
      <h2 id="process-title" class="u-display" {...bi(process.h2)}>{process.h2.bs}</h2>
      <p class="u-lead" {...bi(process.lead)}>{process.lead.bs}</p>
    </div>

    <ol class="routing">
      {process.steps.map((s) => (
        <li class="routing__row">
          <span class="routing__op">{s.op}</span>
          <span class="routing__name" {...bi(s.name)}>{s.name.bs}</span>
          <span class="routing__text" {...bi(s.text)}>{s.text.bs}</span>
          <span class="routing__result">
            <span {...bi(process.resultLabel)}>{process.resultLabel.bs}</span>
            <span {...bi(s.result)}>{s.result.bs}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>
