---
// Hero — početak putovanja
---

<section class="hero" id="pocetak">
  <div class="shell hero-inner">
    <div class="hero-meta">
      <span class="mono">SHADOWDEV</span>
      <span class="dot" aria-hidden="true"></span>
      <span class="mono" style="color: var(--ember);">ONEFORALL</span>
    </div>

    <h1 class="hero-title">
      <span class="line" data-bs="Jedan sistem." data-en="One system.">Jedan sistem.</span>
      <span class="line line--offset" data-bs="Cijela firma." data-en="The whole company.">Cijela firma.</span>
    </h1>

    <div class="hero-lower">
      <p class="hero-lead" data-bs="ShadowDev gradi ERP, MES i softver po mjeri koji povezuje finansije, proizvodnju i prodaju — i web, mobilne aplikacije i marketing koji taj sistem čine vidljivim." data-en="ShadowDev builds ERP, MES and custom software that connects finance, production and sales — plus web, mobile apps and marketing that make the system visible.">
        ShadowDev gradi ERP, MES i softver po mjeri koji povezuje finansije, proizvodnju i prodaju — i web, mobilne aplikacije i marketing koji taj sistem čine vidljivim.
      </p>

      <div class="hero-cta">
        <a href="#stanica-1" class="btn" data-bs="Uđi u sistem" data-en="Enter the system">Uđi u sistem</a>
      </div>
    </div>
  </div>
</section>
