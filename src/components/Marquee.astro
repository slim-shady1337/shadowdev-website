---
// Beskonačni marquee ključnih riječi
const items = ['ERP', 'MES', 'React', 'Astro', '.NET', 'REST API', 'Cloud', 'AI', 'SEO', 'iOS', 'Android', 'SQL', 'CI/CD', 'Analitika'];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {items.map((item) => (
      <span class="marquee-item"><span class="dot"></span>{item}</span>
    ))}
    {items.map((item) => (
      <span class="marquee-item"><span class="dot"></span>{item}</span>
    ))}
  </div>
</div>
