---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Stations from '../components/Stations.astro';
import Convergence from '../components/Convergence.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import Security from '../components/Security.astro';
import References from '../components/References.astro';
import ContactSection from '../components/ContactSection.astro';
---

<BaseLayout title="Jedan sistem za cijelu firmu">
  <!-- Putovanje: hero → uvod → 6 stanica → spajanje -->
  <div id="journey">
    <Hero />
    <Intro />
    <Stations />
    <Convergence />
  </div>

  <!-- Nakon putovanja: mirne, informativne sekcije -->
  <div class="after">
    <ProcessTimeline />
    <Security />
    <References />
    <ContactSection />
  </div>
</BaseLayout>
