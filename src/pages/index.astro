---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Legend from '../components/Legend.astro';
import Stations from '../components/Stations.astro';
import Convergence from '../components/Convergence.astro';
import Process from '../components/Process.astro';
import Security from '../components/Security.astro';
import Proof from '../components/Proof.astro';
import Contact from '../components/Contact.astro';
---

<BaseLayout>
  <Fragment slot="journey">
    <Hero />
    <Legend />
    <Stations />
    <Convergence />
  </Fragment>

  <Process />
  <Security />
  <Proof />
  <Contact />
</BaseLayout>
